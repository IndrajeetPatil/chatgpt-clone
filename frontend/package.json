{
  "name": "chatbot-template-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "rm -rf dist && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "check-types": "tsc --noemit",
    "lint": "biome check --write --unsafe --error-on-warnings biome.json package.json tsconfig.json eslint.config.js playwright.config.ts vite-env.d.ts vite.config.ts vitest.setup.ts .lighthouserc.json .fallowrc.json scripts/ app/ client/ components/ e2e-tests/ src/ index.html",
    "test": "vitest run --coverage",
    "test:update": "vitest run --update",
    "test:e2e": "npx playwright test",
    "fallow": "fallow --fail-on-issues --quiet",
    "css-quality": "node scripts/css-quality.mjs",
    "contrast-audit": "node scripts/contrast-audit.mjs",
    "lint:security": "eslint app client components src",
    "type-coverage": "type-coverage --strict --at-least 100"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.68",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/utils": "^9.3.0",
    "ai": "^7.0.65",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "2.5.3",
    "@fast-check/vitest": "^0.4.1",
    "@playwright/test": "^1.62.1",
    "@projectwallace/css-code-quality": "^3.1.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-dom": "^5.18.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fallow": "^3.16.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "http-status-codes": "^2.3.0",
    "jsdom": "^29.1.1",
    "type-coverage": "^2.30.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
